<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Background Wallpaper -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wallpaper_aurora"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Ambient Scrim Vignette -->
    <View
        android:id="@+id/vScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Right Settings / Wallpaper Button -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/focus_settings_bg"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:nextFocusDown="@id/rvApps"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Clock and Date Container -->
    <LinearLayout
        android:id="@+id/clockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/rvApps"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55">

        <!-- Modern Digital Clock in the Middle -->
        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="96sp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="16" />

        <!-- Date under the Clock -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            tools:text="Sunday, November 22" />

    </LinearLayout>

    <!-- App Ribbon (Horizontal Single Row) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginBottom="44dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_apps_found"
        android:textColor="@color/text_muted"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rvApps"
        app:layout_constraintEnd_toEndOf="@+id/rvApps"
        app:layout_constraintStart_toStartOf="@+id/rvApps"
        app:layout_constraintTop_toTopOf="@+id/rvApps" />

</androidx.constraintlayout.widget.ConstraintLayout>
