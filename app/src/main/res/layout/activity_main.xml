<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 1. High-Res Wallpaper (Bing Daily Nature & Landscapes) -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wallpaper_aurora"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription" />

    <!-- 2. Cinema Grade Vignette & Scrim (guarantees text & card legibility) -->
    <View
        android:id="@+id/vScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_cinematic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Ambient App Glow (Dynamically takes the focused app's vibrant brand color) -->
    <View
        android:id="@+id/vAmbientGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. Top Header Bar: Clean tvOS Greeting, Clock, Date, Stats & Frosted Pills -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Block: Greeting, Time, Date, Live RAM Stats -->
        <LinearLayout
            android:id="@+id/leftBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <!-- Dynamic Greeting (GOOD MORNING / GOOD AFTERNOON / GOOD EVENING) -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.22"
                android:singleLine="true"
                android:text="@string/good_evening"
                android:textAllCaps="true"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp" />

            <!-- Apple TV Clean Digital Clock & Date Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/textClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="#FFFFFFFF"
                    android:textSize="50sp" />

                <TextClock
                    android:id="@+id/tvAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="7dp"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <!-- Vertical Glass Divider -->
                <View
                    android:id="@+id/clockDivider"
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="7dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:background="#33FFFFFF" />

                <!-- Formatted Date -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-regular"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.14"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="#A6FFFFFF"
                    android:textSize="14sp"
                    tools:text="SUNDAY, NOVEMBER 22" />
            </LinearLayout>

            <!-- Debloat & System RAM Indicator -->
            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:text="RAM: 1.1 GB FREE · ZERO ADS · FIRE OS DEBLOATED"
                android:textColor="#70FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right Block: Inputs, Wi-Fi SSID, Settings (Frosted Glass Pills) -->
        <LinearLayout
            android:id="@+id/topButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@id/leftBlock"
            android:layout_marginBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnInputs"
                style="@style/TopButton"
                android:text="@string/inputs"
                android:drawableStart="@drawable/ic_input"
                android:nextFocusDown="@+id/rvApps" />

            <TextView
                android:id="@+id/btnWifi"
                style="@style/TopButton"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/wifi"
                android:drawableStart="@drawable/ic_wifi"
                android:nextFocusDown="@+id/rvApps" />

            <TextView
                android:id="@+id/btnSettings"
                style="@style/TopButton"
                android:text="@string/settings"
                android:drawableStart="@drawable/ic_settings"
                android:nextFocusDown="@+id/rvApps" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 5. Top Shelf: Apple TV Focused App Title & Meta -->
    <LinearLayout
        android:id="@+id/heroLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/rvApps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHeroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp"
            tools:text="Netflix" />

        <TextView
            android:id="@+id/tvHeroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-regular"
            android:letterSpacing="0.04"
            android:singleLine="true"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            tools:text="Video Streaming · Installed" />
    </LinearLayout>

    <!-- 6. Apple TV Horizontal App Ribbon / Dock -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="0dp"
        android:layout_height="216dp"
        android:layout_marginBottom="36dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:nextFocusUp="@+id/btnSettings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 7. Empty State -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_pill"
        android:padding="16dp"
        android:text="@string/no_apps_found"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rvApps"
        app:layout_constraintEnd_toEndOf="@+id/rvApps"
        app:layout_constraintStart_toStartOf="@+id/rvApps"
        app:layout_constraintTop_toTopOf="@+id/rvApps" />

</androidx.constraintlayout.widget.ConstraintLayout>
